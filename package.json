{
  "name": "@h_domi/pdf-canvas-kit",
  "version": "0.1.0",
  "description": "Framework-agnostic PDF editor and viewer — render a PDF as page backgrounds and place your own components on top. Zero framework runtime, thin React and Vue wrappers.",
  "license": "MIT",
  "author": "HDomi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HDomi/pdf-canvas-kit.git"
  },
  "homepage": "https://github.com/HDomi/pdf-canvas-kit#readme",
  "bugs": {
    "url": "https://github.com/HDomi/pdf-canvas-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "keywords": [
    "pdf",
    "pdf-editor",
    "pdf-viewer",
    "pdf-annotation",
    "pdfjs",
    "canvas",
    "overlay",
    "drag-and-drop",
    "react",
    "vue",
    "framework-agnostic",
    "headless"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "node scripts/dev-examples.mjs",
    "dev:demo": "node scripts/copy-pdfjs-assets.mjs && vite --config vite.demo.config.ts --strictPort",
    "dev:local": "node scripts/copy-pdfjs-assets.mjs && vite --config vite.demo.config.ts --host 127.0.0.1 --strictPort",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "preview": "vite preview --config vite.demo.config.ts",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json",
    "lint": "eslint . && prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "checks": "node scripts/run-checks.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "license-check": "npx --yes license-checker-rseidelsohn --production --onlyAllow 'MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;CC0-1.0;Unlicense;0BSD'",
    "copy:pdfjs": "node scripts/copy-pdfjs-assets.mjs",
    "prepare": "node scripts/copy-pdfjs-assets.mjs",
    "verify:tarball": "node scripts/verify-tarball.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run checks && npm run build",
    "examples:build": "npm run build --workspaces --if-present"
  },
  "dependencies": {
    "pdfjs-dist": "^6.2.108"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^8.2.1",
    "vue": "^3.5.41",
    "vue-tsc": "^3.1.2"
  },
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "examples/*"
  ]
}
